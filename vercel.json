{
  "functions": {
    "api/discord-interactions.js": { "maxDuration": 30 },
    "api/cron.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/discord-interactions", "destination": "/api/discord-interactions" },
    { "source": "/api/cron", "destination": "/api/cron" }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 11 * * 1"
    }
  ]
}
